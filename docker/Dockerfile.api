# CPU-only API image. No CUDA base image, no GPU assumptions.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml constraints.txt ./
COPY src ./src
# CPU-only torch wheels explicitly: the default PyPI linux wheel pulls in the full
# CUDA toolkit (~1GB+) even though this container never has a GPU.
RUN pip install --no-cache-dir torch==2.14.1 torchvision==0.29.1 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -e . -c constraints.txt

COPY configs ./configs
COPY scripts ./scripts

# Run unprivileged (uid 1000). The service writes only under data/ (uploads, heatmaps) and its home
# directory; models are read. With the compose bind mounts, ./data must be writable by uid 1000.
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /app/data/uploads /app/data/heatmaps /app/models \
    && chown -R app:app /app /home/app
USER app

# Bake torchvision's ResNet18 ImageNet weights into the image (the PatchCore feature extractor builds
# the backbone from them at start-up), so the container needs no network access to serve.
RUN python -c "import torchvision.models as m; m.resnet18(weights=m.ResNet18_Weights.IMAGENET1K_V1)"

EXPOSE 8000

CMD ["uvicorn", "automotive_vision.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
